# Copy to .env in the repository root. (research_system/.env is read as a fallback;
# keys in the root .env win.) Do not commit your real .env.

# Required: Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_API_VERSION=2024-02-01

# Required for web search
TAVILY_API_KEY=your-tavily-api-key

# Optional: Logfire is off by default. Set both to stream traces to Logfire Cloud.
SEND_TO_LOGFIRE=false
# LOGFIRE_TOKEN=

# Optional: session memory (falls back to in-process memory if MongoDB is unreachable)
# MONGO_URL=mongodb://localhost:27017
# DB_NAME=research_agents

# Optional: Chroma Cloud for semantic memory (falls back to a local ./chroma_db)
# CHROMA_API_KEY=
# CHROMA_TENANT=
# CHROMA_DATABASE=default

# Optional: runtime tuning
# MAX_SUBAGENTS=4
# MAX_SEARCH_RESULTS_PER_AGENT=5
